{
  "name": "@alpacachen/dsh-simple-worktree",
  "version": "1.1.3-desktop.9",
  "description": "A Git worktree plugin for DeepSeek Harness that creates task branches, registers worktrees as DSH Workspaces, and opens isolated sessions.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "worktree"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpacachen/dsh-worktree.git"
  },
  "homepage": "https://github.com/alpacachen/dsh-worktree",
  "bugs": {
    "url": "https://github.com/alpacachen/dsh-worktree/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "docs/preview.png",
    "native"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:ui": "node scripts/test-ui-browser.mjs",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:tracked-bundle": "node scripts/check-tracked-bundle.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "test": "pnpm build && pnpm typecheck && pnpm test:unit && pnpm check:client-bundle && pnpm check:tracked-bundle && pnpm check:package",
    "prepublishOnly": "pnpm test",
    "build:native-relocation": "node scripts/build-native-relocation.mjs",
    "check:relocation-sdk": "node scripts/verify-relocation-sdk.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
